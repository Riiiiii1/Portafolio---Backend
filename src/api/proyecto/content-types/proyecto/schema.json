{
  "kind": "collectionType",
  "collectionName": "proyectos",
  "info": {
    "singularName": "proyecto",
    "pluralName": "proyectos",
    "displayName": "Proyecto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre"
    },
    "descripcionBreve": {
      "type": "string"
    },
    "descripcionCompleta": {
      "type": "blocks"
    },
    "imagen": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "academico",
        "personal",
        "laboral",
        "simulado"
      ]
    },
    "tecnologias": {
      "type": "json"
    },
    "repositorio": {
      "type": "string"
    },
    "demo": {
      "type": "string"
    },
    "destacado": {
      "type": "boolean"
    },
    "programadors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::programador.programador",
      "inversedBy": "proyectos"
    }
  }
}
